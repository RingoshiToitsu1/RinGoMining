# ---- Telegram (required: Telegram is the control interface) ----
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_ADMIN_IDS=            # your numeric Telegram user id(s), comma separated (ask @userinfobot)

# ---- Infrastructure (docker-compose sets these for you) ----
DATABASE_URL=postgresql+asyncpg://arbbot:arbbot@postgres:5432/arbbot
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
LOG_LEVEL=INFO
POSTGRES_PASSWORD=arbbot

# ---- Kalshi ----
KALSHI_ENABLED=true
KALSHI_ENV=prod                         # prod | demo  (demo = Kalshi's sandbox, use it first)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/secrets/kalshi.pem
# Set true only after you have checked that your account, your state and Kalshi's API
# agreement permit automated trading. Live trading stays disabled while this is false.
KALSHI_ELIGIBILITY_CONFIRMED=false

# ---- Polymarket ----
# us   = Polymarket US (regulated US exchange). Keys: polymarket.us/developer
# intl = international CLOB. NOT available to US persons; the bot checks Polymarket's
#        geoblock endpoint and refuses to trade if it says blocked.
# off  = disable the adapter
POLYMARKET_VENUE=us
POLYMARKET_ELIGIBILITY_CONFIRMED=false
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
# Used until the venue reports its real commission on your first order.
POLYMARKET_US_TAKER_FEE_RATE=0.005
POLYMARKET_US_SHORT_PRICE_CONVENTION=long

# international only (requires: pip install ".[intl]")
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=0

# ---- Optional: Claude checks settlement rules of candidate market pairs ----
# Without it, every pair must be approved by you in Telegram (/mappings).
ANTHROPIC_API_KEY=
MATCHER_LLM_MODEL=claude-opus-5-5

# ---- Discovery ----
DISCOVERY_MAX_DAYS_TO_CLOSE=120
DISCOVERY_MIN_VOLUME=0

# Client-side request pacing (requests per second for reads; orders are never delayed)
KALSHI_READS_PER_SECOND=8
POLYMARKET_READS_PER_SECOND=10
